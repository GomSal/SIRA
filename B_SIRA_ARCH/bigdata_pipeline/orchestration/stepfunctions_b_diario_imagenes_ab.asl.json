      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "Glue.AWSGlueException",
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 20,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "Lote_4C_Semaforo_C_Operativo_Sin_Riego"
    },
    "Lote_4C_Semaforo_C_Operativo_Sin_Riego": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "sira-b-04-lote-semaforo-c",
        "Arguments": {
          "--input_oro_pronostico_a": "s3://sira-b-lakehouse-929570730700/oro/pronostico_predictor/",
          "--input_oro_geos_corregido": "s3://sira-b-lakehouse-929570730700/oro/geos_s2s_corregido/",
          "--input_oro_curva_10anios": "s3://sira-b-lakehouse-929570730700/oro/curva_normal_10anios/",
          "--input_oro_predios": "s3://sira-b-lakehouse-929570730700/oro/predios/",
          "--input_bronce_semaforo_c_grid": "s3://sira-b-lakehouse-929570730700/bronce/semaforo_c_repo/pixeles_c_20286.parquet",
          "--output_oro_semaforo_c_pixeles": "s3://sira-b-lakehouse-929570730700/oro/semaforo_c_pixeles/",
          "--output_oro_semaforo_c_resumen": "s3://sira-b-lakehouse-929570730700/oro/semaforo_c_resumen/"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "Glue.AWSGlueException",
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 20,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "Flujo_Diario_Exitoso"
