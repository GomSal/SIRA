{
  "Comment": "SIRA B_SIRA_ARCH (Flujo Diario 05:00 a.m. COT · HEAD 8fde03d): Lote 1 Imagenes (sira-b-01) -> Lote 4AB Predictor A + Semaforo B con riego (sira-b-03) -> Lote 4C Semaforo C operativo sin riego (sira-b-04).",
  "StartAt": "Lote_1_Imagenes_y_Features_A",
  "States": {
    "Lote_1_Imagenes_y_Features_A": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "sira-b-01-lote-imagenes-pixel",
        "Arguments": {
