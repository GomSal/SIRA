          "--input_arimax_params_json": "s3://sira-b-lakehouse-929570730700/models/semaforo_b/arimax1_params.json",
          "--output_oro_pronostico_a": "s3://sira-b-lakehouse-929570730700/oro/pronostico_predictor/",
          "--output_oro_semaforo": "s3://sira-b-lakehouse-929570730700/oro/semaforo/",
