{
  "Comment": "SIRA B_SIRA_ARCH Limpio (Flujo Diario 05:00 a.m. COT): Ejecuta directamente la inferencia unificada ML real en AWS Glue 5.0 (sira-b-05 -> Athena Parquet + App Lovable formato 2 + simulador_riego.json).",
  "StartAt": "Inferencia_Unificada_ML_Real_y_App",
  "States": {
    "Inferencia_Unificada_ML_Real_y_App": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "sira-b-05-inferencia-unificada-ml",
        "Arguments": {
          "--s3_bucket": "sira-b-lakehouse-929570730700",
          "--aws_region": "us-east-2",
          "--athena_db": "sira_b_lakehouse_db",
          "--predio_id": "NATAIMA_01",
          "--fecha_hoy": "auto",
          "--riego_supuesto": "CD",
          "--prefer_oro_geos": "true"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "Glue.AWSGlueException",
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 20,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "Flujo_Diario_Exitoso"
    },
    "Flujo_Diario_Exitoso": {
      "Type": "Succeed"
    }
  }
}
