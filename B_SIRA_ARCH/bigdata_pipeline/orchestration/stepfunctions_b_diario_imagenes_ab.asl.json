          "--output_plata_indices_pixel": "s3://sira-b-lakehouse-929570730700/plata/indices_pixel/"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "Glue.AWSGlueException",
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 20,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "Lote_4AB_Predictor_A_y_Semaforo_B"
