{
  "Comment": "SIRA B_SIRA_ARCH Limpio (Flujo Cada 5 Dias): Clima 26 anos + correccion GEOS-S2S-3 (sira-b-02) -> Inferencia Unificada ML Real 400 ha + App Lovable (sira-b-05).",
  "StartAt": "Lote_2_Clima_y_GEOS_S2S",
  "States": {
    "Lote_2_Clima_y_GEOS_S2S": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "sira-b-02-lote-clima-y-geos",
        "Arguments": {
          "--input_bronce_chirps": "s3://sira-b-lakehouse-929570730700/bronce/chirps/",
          "--input_bronce_power": "s3://sira-b-lakehouse-929570730700/bronce/power/",
          "--input_bronce_geos_nrt": "s3://sira-b-lakehouse-929570730700/bronce/geos_s2s/geos_s2s_nrt.parquet",
          "--input_plata_cubo_clima": "s3://sira-b-lakehouse-929570730700/plata/cubo_a/clima.csv",
          "--input_bronce_geos_csv": "s3://sira-b-lakehouse-929570730700/bronce/geos_s2s_a/geos_nrt.csv",
          "--input_oro_coeficientes": "s3://sira-b-lakehouse-929570730700/oro/correccion_coeficientes/",
          "--output_plata_clima_observado": "s3://sira-b-lakehouse-929570730700/plata/clima_observado/",
          "--output_plata_geos_crudo": "s3://sira-b-lakehouse-929570730700/plata/geos_s2s_crudo/",
          "--output_oro_geos_corregido": "s3://sira-b-lakehouse-929570730700/oro/geos_s2s_corregido/"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "Glue.AWSGlueException",
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 20,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "Inferencia_Unificada_ML_Real_y_App"
    },
    "Inferencia_Unificada_ML_Real_y_App": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "sira-b-05-inferencia-unificada-ml",
        "Arguments": {
          "--s3_bucket": "sira-b-lakehouse-929570730700",
          "--aws_region": "us-east-2",
          "--athena_db": "sira_b_lakehouse_db",
          "--predio_id": "NATAIMA_01",
          "--fecha_hoy": "auto",
          "--riego_supuesto": "CD",
          "--prefer_oro_geos": "true"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "Glue.AWSGlueException",
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 20,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "Flujo_GEOS_Exitoso"
    },
    "Flujo_GEOS_Exitoso": {
      "Type": "Succeed"
    }
  }
}
